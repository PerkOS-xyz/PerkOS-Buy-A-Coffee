# --- Service ---
APP_URL=https://buyacoffee.perkos.xyz
SESSION_SECRET=change-me-to-32-plus-random-characters
# --- Firestore (Firebase project `perkos-coffee`) ---
# Optional: without credentials the service runs in wallet mode (payments, badges by address and health
# work; handles, profiles and memos do not). Fill ONE of the two forms, from the service-account JSON
# (Firebase console > Project settings > Service accounts > Generate new private key).
#
# Form A: the three fields of the JSON. Keep the private key in double quotes, on one line, with the
# literal \n sequences exactly as they appear in the file.
FIREBASE_PROJECT_ID=perkos-coffee
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_client_email_FROM_JSON
FIREBASE_PRIVATE_KEY="REPLACE_WITH_private_key_FROM_JSON"
#
# Form B: the whole JSON file on one line (takes precedence over form A when set).
FIREBASE_SERVICE_ACCOUNT=

# --- Sign-in (Privy, wallet login; public app id, no server secret needed) ---
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_NETWORK=base-sepolia

# --- Networks ---
# Default network (first in the list) and the networks this deployment serves.
# Each needs a CoffeeSplit address: base and base-sepolia are known; others via COFFEE_SPLIT_ADDRESS_<KEY>.
NETWORK=base
NETWORKS=base,celo,robinhood
COFFEE_SPLIT_ADDRESS_CELO=
COFFEE_SPLIT_ADDRESS_ROBINHOOD=
COFFEE_SPLIT_FROM_BLOCK_CELO=
COFFEE_SPLIT_FROM_BLOCK_ROBINHOOD=
# Optional per-network RPC overrides: RPC_URL_BASE, RPC_URL_CELO, RPC_URL_ROBINHOOD (RPC_URL applies to the default network).
# Optional blocks per eth_getLogs call, LOG_CHUNK_<KEY> (defaults match the public RPCs' caps: base 2000, celo 4999,
# base-sepolia 9000, robinhood 50000). Only needed when RPC_URL_<KEY> points at a provider with a different cap; the
# scanner halves the window on its own when an RPC refuses it.

# --- Facilitator (Stack) ---
PERKOS_STACK_URL=https://stack.perkos.xyz
# API key whose verified vendor domain is buyacoffee.perkos.xyz: activates gas sponsorship for anonymous donors.
PERKOS_STACK_API_KEY=

# --- Operations ---
# Sponsor wallet that pays settlement gas (Stack, PerkOS). /api/health reports its balance.
SPONSOR_WALLET_ADDRESS=0xdeB7B3F9D1698589E7024abF301B23Fa18533d12
# Below this ETH balance /api/health flags sponsorLow and the daily cron posts to the webhook (optional).
SPONSOR_LOW_ETH=0.005
ALERT_WEBHOOK_URL=
